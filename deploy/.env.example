# ============================================================================
# ExNihilo / SFO - variables d'environnement (copier ce fichier en `.env`)
#   cp .env.example .env   puis remplir chaque valeur.
# NE JAMAIS committer le fichier .env rempli.
# Les trois secrets (mots de passe + JWT_SECRET) peuvent être générés avec :
#   ./gen-keys.sh          (affiche aussi les jetons ANON / SERVICE à reporter)
# ============================================================================

# --- URL publique de l'application (à définir avec la DSI, ex: https://sfo.axentia.fr)
SITE_URL=https://sfo.axentia.fr

# --- Base de données -------------------------------------------------------
POSTGRES_DB=exnihilo
POSTGRES_USER=postgres
# Mot de passe superutilisateur Postgres (admin / migrations)
POSTGRES_PASSWORD=CHANGER_MOI_mdp_postgres
# Mot de passe du rôle de connexion PostgREST (différent du précédent)
AUTHENTICATOR_PASSWORD=CHANGER_MOI_mdp_authenticator

# --- Secret JWT ------------------------------------------------------------
# Chaîne aléatoire d'au moins 32 caractères. PARTAGÉE entre GoTrue (qui signe
# les jetons de session) et PostgREST (qui les vérifie). La changer invalide
# toutes les sessions et les jetons ANON/SERVICE (à régénérer via gen-keys.sh).
JWT_SECRET=CHANGER_MOI_secret_jwt_32_caracteres_minimum

# --- SSO Microsoft Entra ID -------------------------------------------------
# Passer AZURE_SSO_ENABLED à true quand les 3 valeurs Entra sont renseignées.
# L'URI de redirection déclarée dans Entra doit être : ${SITE_URL}/auth/v1/callback
# ATTENTION : pas de /v2.0 final sur AZURE_TENANT_URL (GoTrue ajoute lui-même
# /oauth2/v2.0/authorize ; avec /v2.0 l'URL générée est doublonnée -> 404 Microsoft).
AZURE_SSO_ENABLED=false
AZURE_TENANT_URL=https://login.microsoftonline.com/TENANT_ID
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Jetons applicatifs (générés par gen-keys.sh à partir de JWT_SECRET) ----
# ANON_KEY   : à reporter dans app.js (constante SUPABASE_KEY) - clé publique du front
# SERVICE_KEY : réservé à l'admin (création des comptes utilisateurs, cf. INSTALL.md)
#               à conserver hors du dépôt, jamais côté client
ANON_KEY=genere_par_gen-keys.sh
SERVICE_KEY=genere_par_gen-keys.sh
